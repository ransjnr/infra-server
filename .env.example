# Copy to .env and fill in real values. Do not commit .env.

# Ghana NLP (or other) API key for speech / NLP integrations
GHANA_NLP_API_KEY=

# PostgreSQL connection string (use host `postgres` inside Docker Compose)
DATABASE_URL=postgresql://infra:infra@postgres:5432/infra

# Gateway JWT (set a long random string in production, e.g. openssl rand -hex 32)
JWT_SECRET=change-me-in-production

# Set to false only for local debugging (disables Bearer requirement on /api/*)
AUTH_ENABLED=true

# Optional on Render / HTTPS: public URL of the gateway (no trailing slash) so /docs "Try it out" uses the right host
# PUBLIC_BASE_URL=https://your-gateway.onrender.com

# Upstreams (gateway defaults match Docker Compose service names)
# DATASET_MANAGER_URL=http://dataset-manager:8001
# INTELLIGENCE_SERVICE_URL=http://intelligence:8002
# SPEECH_SERVICE_URL=http://speech:8003

# Gateway CORS: comma-separated origins, or * for any (disables credentials)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: override defaults from docker-compose.yml
# POSTGRES_USER=infra
# POSTGRES_PASSWORD=infra
# POSTGRES_DB=infra
# REDIS_URL=redis://redis:6379/0
